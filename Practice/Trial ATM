def main():
    balance = 1000
    print("1.Check Balance")  
    print("2.Deposit")  
    print("3.Withdrawl")
    print("4.Exit")
    while True:
        enter = int(input("Choose the option with respective number:"))
        if enter == 1:
          print(f"Current Balance: {balance}")
        elif enter == 2:
          amount1 = int(input("Enter Amount:"))
          balance = balance + amount1
          print(f"Rs. {amount1} deposited succesfully,Balance Amount: {balance}.Rs")
        elif enter == 3:
          amount2 = int(input("Enter Amount to be withdrawl:"))
          if amount2 > balance:
              print("Insufficient Balance")
          else: 
            balance = balance - amount2
            print(f"{amount2}.Rs Withdrawled Succesfully")
        elif enter==4:
           print("Thanks for your time!!")
           break
        else:
           print("Invalid choice,Try again")
           
          
        
main()
